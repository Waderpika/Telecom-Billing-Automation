<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="E-Commerce Automation Suite" parallel="methods" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.ayush.framework.listeners.TestListener"/>
    </listeners>

    <test name="Login Tests">
        <classes>
            <class name="com.ayush.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Inventory Tests">
        <classes>
            <class name="com.ayush.tests.InventoryTest"/>
        </classes>
    </test>

    <test name="End to End Checkout Tests">
        <classes>
            <class name="com.ayush.tests.CheckoutTest"/>
        </classes>
    </test>

    <test name="API Tests">
        <classes>
            <class name="com.ayush.tests.ApiTest"/>
        </classes>
    </test>

</suite>
